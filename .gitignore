# Source dumps. `data` is a symlink to wherever the Wikimedia dumps live
# (content exports alone are hundreds of GB).
/data

# Pipeline intermediates and outputs — regenerated by `make`, also hundreds of GB.
/run/

# Rust build artifacts
/target/

# flock files used to serialize make recipes
/.*.lock

# Dated query-result exports (e.g. wp_not_wd_20260420.csv, ~100 MB each)
/queries/*.csv
